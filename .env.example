# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables. Never commit real values.

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with the database password you chose when creating the project.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Random secret used to sign sign-in cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# One-time code for creating the first admin at /admin/setup. Make it long and random.
# You can delete it from Vercel once your admin account exists.
ADMIN_SETUP_CODE=
